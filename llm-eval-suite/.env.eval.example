# Copy to .env.eval and fill in. No quotes around values: Docker's --env-file
# keeps quote characters literally. Spaces in values are fine as-is.
# Lines starting with # are ignored.

############################################################
# Superset
############################################################

# Where the suite reaches Superset.
#   With ./run_evals.sh (the usual way): http://host.docker.internal:8088
#     The suite runs in its own container, where localhost is the container
#     itself; host.docker.internal is Docker's name for your machine.
#   Suite running on your machine (--local):       http://localhost:8088
#     (--local turns host.docker.internal into localhost itself)
#   Suite in Docker on Superset's compose network: http://superset:8088
#     (the service name from Superset's docker-compose.yml; find the network
#      name with `docker network ls`, usually superset_default)
SUPERSET_URL=http://host.docker.internal:8088

# A Superset login allowed to use the plugin and SQL Lab.
# Ideally a dedicated read-only user, not your admin account.
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
# db for normal Superset users, ldap if your Superset logs in via LDAP.
SUPERSET_AUTH_PROVIDER=db
# A Superset that takes its users from request headers instead (production's
# does): SUPERSET_AUTH=headers posts no password and sends SUPERSET_HEADERS,
# Name=value pairs, with every request. See production/settings.env.
# SUPERSET_AUTH=headers
# SUPERSET_HEADERS=X-Forwarded-User=llm-eval-suite

# The database the plugin queries: Superset's examples database, where
# test_data/load_acled.sh puts the test tables. Usually 1; to check, log into
# Superset and open http://localhost:8088/api/v1/database/ (or look at SQL
# Lab's database dropdown).
SUPERSET_DATABASE_ID=1

# The default schema for SQL Lab queries: acled, where the ACLED test tables
# are. Goldens name their tables with the schema (acled.global_events), so
# tables in other schemas work too.
SUPERSET_SCHEMA=acled

# sqlglot dialect of that database: postgres, mysql, snowflake, bigquery,
# trino, redshift, duckdb, mssql (tsql), ... Match the SQLAlchemy URI prefix
# under Settings > Database Connections.
SQL_DIALECT=postgres

# Notes on the tables (columns, indexes, row counts, descriptions) for the
# metrics and the judge. By default the suite reads
# evals/schema_metadata.json, which describes the test tables; set this
# only to use a different file.
# SCHEMA_METADATA_FILE=/path/to/schema_metadata.json

# Tables with at least this many rows get the "large table" rules: filter on
# an indexed column, and aggregate or LIMIT. The judge is told the same.
# 500000 makes ACLED's global_events (~1M rows) large and the summaries not.
LARGE_TABLE_ROWS=500000

# The most rows SQL Lab returns per query. A result cut off at this limit
# never counts as matching, and a golden whose reference SQL returns more
# can't be graded. Superset caps it at its DISPLAY_MAX_ROW (10000 by default).
SQL_ROW_LIMIT=10000

# With ./run_evals.sh --parallel: how many requests from the suite Superset
# gets at once. The main stack's development server (flask run
# --without-threads) answers one at a time, so more would wait in its queue
# and Plugin Latency would time the queue. Raise it only for a Superset that
# answers more at once (gunicorn: workers times threads).
SUPERSET_MAX_CONCURRENT=1
# With --parallel and a judge that runs as a program on this machine: how
# many judgements it makes at once.
# JUDGE_MAX_CONCURRENT=4

############################################################
# Plugin
############################################################

# Where the plugin's endpoints live; each golden picks one of them
# (generate-sql, refine-sql, generate-nl, ...; see evals/plugin/endpoints.py).
PLUGIN_BASE_PATH=/extensions/waxwing/nltosqlandback

# Fail a golden if the plugin takes longer than this (seconds).
PLUGIN_LATENCY_BUDGET_S=45
# Endpoints that get their own limit instead, e.g. accelerate (query plan,
# rewrite, check, maybe a retry) or describe-breakdown (long text):
#   PLUGIN_LATENCY_BUDGETS=accelerate=60, describe-breakdown=45
PLUGIN_LATENCY_BUDGETS=

# Speed metrics: queries are run and timed on the database (no judge).
# Accelerate's rewrite is scored on the share of the original's time it saves
# (1 - rewrite / original: an hour down to 3 minutes scores 0.95) and passes
# at this score or more (0.5 = twice as fast).
ACCELERATE_MIN_SAVING=0.5
# Other SQL vs the golden's reference SQL: up to this share slower passes...
REFERENCE_TIME_TOLERANCE=0.2
# ...and beyond that it only fails if it is also more than this many ms
# slower, so tiny queries whose percentages are timing jitter don't fail.
REFERENCE_MIN_SLOWDOWN_MS=500
# Timed runs per query after one warm-up run (the median is compared).
TIMING_RUNS=3
# A query still running after this many seconds is cancelled and counts as
# taking at least this long. Keep it under Superset's SQLLAB_TIMEOUT (30s).
TIMING_TIMEOUT_S=25
# How queries are timed, both by EXPLAIN ANALYZE (the database's own time):
#   psql    through psql in the examples database's container (the default
#           outside Docker), as the user Superset connects as. Superset stays
#           free for other workers while a query is timed (--parallel)
#   sqllab  through SQL Lab (always in Docker, which has no docker command,
#           and the default with --local)
# The container is EXAMPLES_DB_CONTAINER (default superset-db-1), the user
# EXAMPLES_DB_USER and database EXAMPLES_DB_NAME (default examples).
# TIMING_VIA=psql

############################################################
# Judge model (grades correctness and query efficiency)
############################################################

# openai | anthropic | azure | ollama | openrouter | vllm | none
# none skips the judged metrics and runs only the metrics that don't use the judge.
# The team currently judges with gemma-4-31b on OpenRouter. It's the same
# model the plugin uses, so expect to switch to a different one; compare only
# runs judged by the same model.
JUDGE_PROVIDER=openrouter
JUDGE_MODEL_NAME=google/gemma-4-31b-it
# The provider's API key. Either JUDGE_API_KEY or the provider's usual
# variable (OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY, AZURE_OPENAI_API_KEY).
OPENROUTER_API_KEY=
# Score from 0 to 1 a judged metric needs to pass. 0.8 is the rubrics' "right;
# only wording could improve": an answer missing a detail that matters (6-7) fails.
JUDGE_THRESHOLD=0.8

# For openai, azure, ollama and vllm: the server's address. A self-hosted
# server that speaks the OpenAI API: JUDGE_PROVIDER=openai with its /v1
# address here.
# JUDGE_BASE_URL=
# JUDGE_AZURE_DEPLOYMENT=
# JUDGE_AZURE_API_VERSION=

# Only for openai with JUDGE_BASE_URL: a server reached over mutual TLS, as
# the plugin's NLSQL_LLM_CLIENT_CERT and so on (evals/judge/tls.py;
# production/settings.env has them filled in). Paths to PEM files: the
# client certificate, its key if that's a separate file, the key's password
# if it's encrypted, and the CAs to trust for the server's own certificate.
# With no JUDGE_API_KEY, no Authorization header is sent.
# JUDGE_CLIENT_CERT=
# JUDGE_CLIENT_KEY=
# JUDGE_CLIENT_KEY_PASSWORD=
# JUDGE_CA_BUNDLE=
# Extra headers on every judge request, as Name=value pairs separated by
# commas, e.g. the username header the plugin sends (NLSQL_LLM_USER_HEADER).
# JUDGE_HEADERS=X-Superset-User-Name=llm-eval-suite

# A second model of the same provider that judges borderline scores again,
# and whose verdict counts (evals/judge/second_opinion.py).
# JUDGE_SECOND_OPINION_MODEL=

############################################################
# Run behaviour
############################################################

# 1 = fail instead of skip when Superset is unreachable or values are missing (use in CI).
STRICT_LIVE=0
# Tag sent to the plugin with each request (X-LLM-Eval-Run); random if unset.
# EVAL_RUN_ID=
DEEPEVAL_TELEMETRY_OPT_OUT=1
