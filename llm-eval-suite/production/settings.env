# The suite's settings in production, where it runs as a Kubernetes Job
# from the suite's image (job.yaml, in this folder). Step 2 of README.md, in
# this folder:
#
#   fill in the values marked <...>, here
#   kubectl create configmap llm-eval-suite-settings --from-env-file=settings.env
#
# Secret values and the certificate files go in Secrets, not here: steps 3
# and 4 of README.md say how. No quotes around values. Lines starting with #
# are ignored. This file holds only what production needs; the suite's
# .env.eval.example explains every other setting. The same names work in a
# .env.eval file, for a run outside the cluster.

############################################################
# Superset (from the Superset administrator)
############################################################

# Superset's address, as the suite's pod reaches it.
SUPERSET_URL=<superset-address>

# Signing in. Production's Superset doesn't ask for a password: the sign-in
# in front of it tells it who is calling, in request headers. So the suite
# sends those headers itself, and they name the suite's own user.
#
#   TO FILL IN, from the Superset administrator:
#     - the name of each header Superset reads to learn who is calling;
#     - the value of each that makes the caller the suite's user.
#   Until then the suite stops before its first request and says
#   "Set real values for: SUPERSET_HEADERS".
#
# Name=value pairs, separated by commas; a value may hold commas itself:
#   SUPERSET_HEADERS=<user-header>=llm-eval-suite,<groups-header>=a,b
# If a value is a secret (a token something in front of Superset checks),
# put the whole SUPERSET_HEADERS line in the llm-eval-suite-login Secret
# instead of here.
SUPERSET_AUTH=headers
SUPERSET_HEADERS=<header-name>=<suite-user>

# The suite's user needs the Gamma, sql_lab and EXTENSIONS roles: enough to
# use SQL Lab and the plugin, as a person would. Not an Admin.

# Only for a Superset that signs people in with its own username and
# password: these three in place of the two above, and SUPERSET_PASSWORD in
# the llm-eval-suite-login Secret.
# SUPERSET_AUTH=password
# SUPERSET_USERNAME=<username>
# SUPERSET_AUTH_PROVIDER=db

# A database people already use the plugin on, which the account can query:
# its ID in Superset (the number in /api/v1/database/, or in the address of
# its page under Settings > Database Connections) and its default schema.
SUPERSET_DATABASE_ID=<id>
SUPERSET_SCHEMA=<schema>
SQL_DIALECT=postgres

# Only if Superset's own HTTPS certificate comes from an in-house CA: that
# CA's certificates, as a PEM file added to the llm-eval-suite-certs Secret.
# REQUESTS_CA_BUNDLE=/certs/superset-ca.pem

############################################################
# The judge (from the plugin's settings and the model server's owner)
############################################################

# The judge is a model on the same server as the plugin's, reached the same
# way. Three values come from the plugin's settings in production's
# superset_config_docker.py: the address, the CA file and the name of the
# username header.

# The model that grades the answers, by the name the model server knows it.
# This is the one setting to change to judge with another model. Use a model
# other than the plugin's (NLSQL_LLM_MODEL): a judge grading its own model's
# answers is less trustworthy. Compare pass rates only between runs judged
# by the same model.
JUDGE_MODEL_NAME=<model>

# The model server's address: the plugin's NLSQL_LLM_BASE_URL, unchanged.
JUDGE_PROVIDER=openai
JUDGE_BASE_URL=https://<model-server>/v1

# The client certificate the model server knows the suite by, and its key,
# as PEM files: where the Job mounts the llm-eval-suite-certs Secret. For an
# encrypted key, add JUDGE_CLIENT_KEY_PASSWORD to the llm-eval-suite-login
# Secret.
JUDGE_CLIENT_CERT=/certs/client.pem
JUDGE_CLIENT_KEY=/certs/client.key

# The CA that signed the model server's own certificate: the file the
# plugin's NLSQL_LLM_CA_BUNDLE names, in the same Secret. Leave it out if the
# plugin sets none.
JUDGE_CA_BUNDLE=/certs/ca.pem

# The username header the plugin sends the model server. Use the header name
# in the plugin's NLSQL_LLM_USER_HEADER; the value is the name the server
# will see the suite's requests under. Leave it out if the plugin sets none.
JUDGE_HEADERS=X-Superset-User-Name=llm-eval-suite

# The model server has no API keys: it knows the suite by its certificate.
# Leave this empty unless the server's owner issues a key.
JUDGE_API_KEY=

# The score from 0 to 1 a judged metric needs to pass.
JUDGE_THRESHOLD=0.8

############################################################
# Run behaviour
############################################################

# Fail, don't skip, when Superset can't be reached or a value is missing.
STRICT_LIVE=1
# Time queries through SQL Lab: the other way needs Docker.
TIMING_VIA=sqllab
# Superset gets one request from the suite at a time.
SUPERSET_MAX_CONCURRENT=1
# How long the suite waits for one answer from the plugin, in seconds. The
# plugin itself waits up to 600 for its model.
REQUEST_TIMEOUT_S=600
# How long the judge may take, in seconds: for all of one golden's metrics,
# and for one request. Raise them if a slow model's judgements time out.
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=600
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=300
# Nothing about a run is sent to DeepEval. Never add CONFIDENT_API_KEY:
# with it, DeepEval uploads every run, its SQL and rows included, to its
# hosted service.
DEEPEVAL_TELEMETRY_OPT_OUT=1

############################################################
# Pass marks and timing (optional: these are the defaults)
############################################################

# Uncomment a line to change it. Changing a pass mark makes earlier runs
# incomparable. The suite's .env.eval.example explains each one.
# PLUGIN_LATENCY_BUDGET_S=45
# TABLE_SELECTION=embedding-then-model
# PLUGIN_LATENCY_BUDGETS=accelerate=60, describe-breakdown=45
# ACCELERATE_MIN_SAVING=0.5
# REFERENCE_TIME_TOLERANCE=0.2
# REFERENCE_MIN_SLOWDOWN_MS=500
# TIMING_RUNS=3
# TIMING_TIMEOUT_S=25
