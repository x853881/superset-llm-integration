# Copy this file to .env and fill in your details.
# Read by both docker compose (docker-compose.yaml) and the acceptance tests' Playwright config.

# OpenRouter. The stand-in needs it to pass requests through (the default) or to record
# (npm run harness:record, in e2e/). Never needed to replay, and never in CI.
# OPENROUTER_API_KEY=

# Superset, as you and the tests reach it. Keep BASE_URL's port in step with SUPERSET_PORT.
SUPERSET_PORT=8088
BASE_URL=http://localhost:8088

# Superset's admin; Superset creates it at start-up. The tests sign in as it only to create a fresh
# analyst for each test, through Superset's API. It is also who you sign in as to use the app by hand.
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# The LLM stand-in's control channel.
STAND_IN_PORT=8080
STAND_IN_URL=http://localhost:8080

# Arize Phoenix: set this and start with `docker compose --profile phoenix up`.
# NLSQL_PHOENIX_ENDPOINT=http://phoenix:6006
